# Copy to .env.production (gitignored). Never commit real values.
ENVIRONMENT=production
LEARNFLOW_PIPELINE_MODE=real
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET_KEY=
PUBLIC_ORIGIN=https://learnflow.example.com
DAILY_PAID_JOB_LIMIT=10
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=
POSTGRES_DB=learnflow
# For the Compose Postgres service, use hostname postgres, not localhost.
DATABASE_URL=postgresql://learnflow:ENCODED_PASSWORD@postgres:5432/learnflow
PLANNER_PROVIDER=openrouter
OPENROUTER_PLANNER_MODEL=openai/gpt-6-luna
PAID_PLANNER_MAX_TOKENS=12000
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LEARNFLOW_V3_GPT_ARRAY_PREVIEW=false
LEARNFLOW_V3_BINARY_PREVIEW=false
LEARNFLOW_V3_NARRATED_LESSON=false
LEARNFLOW_V3_EVENT_ALIGNMENT=false
ARTIFACTS_DIR=/app/artifacts
